# Which image generation backend to use: "pollinations" (default, zero
# setup, no key or billing at all), "gemini" (needs an API key + Google
# Cloud billing linked — see below), or "openai" (paid only, no free tier).
IMAGE_PROVIDER=pollinations

# --- Pollinations.ai ---
# No configuration needed. Free, unauthenticated, no signup. Trade-off:
# lower and less consistent quality than the paid providers below, an
# informal/unpublished rate limit (the app paces its 3 calls with a few
# seconds between them), and no uptime guarantee.
# POLLINATIONS_MODEL=flux

# --- Gemini (Google AI Studio) ---
# Required when IMAGE_PROVIDER=gemini. Create a key at
# https://aistudio.google.com/apikey. IMPORTANT: as of late 2025, Google
# gates image-generation models behind Cloud Billing being linked to the
# key's project — even a key with billing enabled is pay-as-you-go, not a
# genuinely free tier, though there's no minimum spend. Without billing
# linked you'll get a 429 quoting a free-tier quota of 0. See
# https://ai.google.dev/gemini-api/docs/rate-limits.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-image

# --- OpenAI ---
# Required when IMAGE_PROVIDER=openai.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# IMAGE_MODEL=gpt-image-1
# IMAGE_SIZE=1024x1024        # one of: 1024x1024, 1024x1536, 1536x1024, auto
# IMAGE_QUALITY=high          # one of: low, medium, high, auto
