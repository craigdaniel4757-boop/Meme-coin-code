# Which image generation backend to use: "gemini" (default, has a free
# tier) or "openai" (paid only, no free tier).
IMAGE_PROVIDER=gemini

# --- Gemini (Google AI Studio) ---
# Required when IMAGE_PROVIDER=gemini.
# Get a free key at https://aistudio.google.com/apikey — no credit card
# required. Free tier: up to 500 images/day.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-image

# --- OpenAI ---
# Required when IMAGE_PROVIDER=openai.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# IMAGE_MODEL=gpt-image-1
# IMAGE_SIZE=1024x1024        # one of: 1024x1024, 1024x1536, 1536x1024, auto
# IMAGE_QUALITY=high          # one of: low, medium, high, auto
