# Copy this file to `.env` and fill in only what you need.
# NEVER commit your real .env, and never paste a private key into chat, a
# commit, or a log message. `.env` is already listed in .gitignore.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Live trading (ONLY required if config execution.mode is set to "live").
# Leave these blank to stay in paper-trading mode, which is the default and
# does not touch a real wallet.
# ---------------------------------------------------------------------------
# Base58-encoded secret key of the trading wallet (e.g. exported from
# Phantom/Solflare "Show Private Key"). Fund this wallet with ONLY the
# amount you are fully prepared to lose, and use a wallet that holds
# nothing else of value.
SOLANA_PRIVATE_KEY=

# Any Solana RPC endpoint you trust; public endpoints are heavily
# rate-limited, so a dedicated RPC provider is strongly recommended for
# live trading.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ---------------------------------------------------------------------------
# Optional alerting
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Optional data providers
# ---------------------------------------------------------------------------
# GeckoTerminal works without a key at a lower rate limit; add a key
# (CoinGecko API) if you have one to raise it.
GECKOTERMINAL_API_KEY=
