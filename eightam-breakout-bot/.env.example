# Copy this file to `.env` and fill in only what you need.
# NEVER commit your real .env, and never paste an API key/secret into chat,
# a commit, or a log message. `.env` is already listed in .gitignore.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Live trading (ONLY required if config execution.mode is set to "live").
# Leave these blank to stay in paper-trading mode, which is the default and
# never places a real order. Create keys scoped to trading only (no
# withdrawal permission) on whichever exchange you configure in
# config/default.yaml's market.exchange.
# ---------------------------------------------------------------------------
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# A few exchanges (e.g. OKX, KuCoin) also require a passphrase -- leave
# blank if yours doesn't.
EXCHANGE_API_PASSPHRASE=

# ---------------------------------------------------------------------------
# Optional alerting
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
