# Enables live vision analysis + coaching generation.
# Leave unset (or set DEMO_MODE=true below) to run entirely in demo mode,
# where uploads go through the same pipeline stages but return the bundled
# sample report instead of a live Claude analysis.
ANTHROPIC_API_KEY=

# Used for both vision frame-reading and coaching report generation.
ANTHROPIC_MODEL=claude-opus-5

# Force demo mode even if ANTHROPIC_API_KEY is set (handy for local dev
# without spending API credits).
DEMO_MODE=false

PORT=8787

# Seconds between ffmpeg frame samples during extraction. Lower = more
# granular reads but more Claude vision calls per video.
FRAME_INTERVAL_SECONDS=3

# How many extracted frames are sent to Claude per vision request.
FRAME_BATCH_SIZE=6

# Where uploaded videos, extracted frames, and job/report state are stored.
STORAGE_DIR=./storage

# Max upload size in MB.
MAX_UPLOAD_MB=500

# Comma-separated list of allowed origins for CORS.
CORS_ORIGIN=http://localhost:5173
